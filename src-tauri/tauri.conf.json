{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "あきんどカルタ",
  "version": "1.0.0",
  "identifier": "jp.denzaburo.akindo-karuta",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "あきんどカルタ",
        "width": 744,
        "height": 430,
        "resizable": true,
        "minWidth": 434,
        "minHeight": 200,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}